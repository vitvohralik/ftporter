{
  "name": "ftporter",
  "version": "2.0.0",
  "description": "Your files' porter — an interactive SFTP deploy session, watcher and patrol.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/vitvohralik/ftporter.git" },
  "homepage": "https://github.com/vitvohralik/ftporter#readme",
  "bugs": "https://github.com/vitvohralik/ftporter/issues",
  "author": "Vít Vohralík",
  "keywords": [
    "sftp",
    "ftp",
    "ftps",
    "sync",
    "deploy",
    "upload",
    "watch",
    "watcher",
    "mirror",
    "ssh2",
    "vscode",
    "deployment"
  ],
  "bin": {
    "ftporter": "bin/ftporter.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "ftporter.config.example.jsonc",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.mjs",
    "lint": "for f in bin/*.mjs src/*.mjs test/*.mjs; do node --check \"$f\" || exit 1; done",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "basic-ftp": "^6.2.0",
    "chokidar": "^4.0.3",
    "ssh2": "^1.17.0"
  }
}
